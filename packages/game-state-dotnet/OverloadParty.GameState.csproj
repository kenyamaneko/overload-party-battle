<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>OverloadParty.GameState</PackageId>
    <Version>0.0.0</Version>
    <Description>Overload Party game state contracts (ClientGameState / PlayerView / OpponentView / Field / EventData / AvailableAction). Auto-generated from data/openapi.yaml via NSwag. Distributed only as a sln-internal ProjectReference (no NuGet publish).</Description>
    <IsPackable>false</IsPackable>
    <RepositoryUrl>https://github.com/kenyamaneko/overload-party-battle</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="cache/cards_gen.json" />
  </ItemGroup>
</Project>
