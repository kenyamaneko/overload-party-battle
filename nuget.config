<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet feed configuration for Cloudsmith.

  CI: kenyamaneko/overload-party-common/.github/actions/setup-cloudsmith-auth
  exchanges the GitHub Actions OIDC token for a Cloudsmith API key and
  registers credentials into the ambient NuGet config. No credentials are
  written here.

  Local dev: developers configure ~/.nuget/NuGet/NuGet.Config with a personal
  Cloudsmith entitlement token before running `dotnet restore` (see README).
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cloudsmith-overload-party-nuget" value="https://nuget.cloudsmith.io/keyandnotes/overload-party-nuget/v3/index.json" />
  </packageSources>
</configuration>
