<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-level NuGet config declares only the public nuget.org feed.

  Cloudsmith feed (where OverloadParty.GameDesignConstants lives) is
  registered into the user-level NuGet.Config dynamically:

    - CI: kenyamaneko/overload-party-common/.github/actions/setup-cloudsmith-auth
      exchanges the GitHub Actions OIDC token for a Cloudsmith API key and
      runs `dotnet nuget add source ... cloudsmith-overload-party-nuget`.

    - Local dev: developers configure ~/.nuget/NuGet/NuGet.Config once with a
      personal Cloudsmith entitlement token (see README).

  We intentionally do NOT declare cloudsmith-overload-party-nuget here so that
  the composite's `dotnet nuget add source` does not conflict with an existing
  project-level entry of the same name.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
