<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub Packages の認証設定:
  ユーザーレベルの NuGet 設定 (~/.nuget/NuGet/NuGet.Config) に認証情報を追加する必要があります。
  新しい環境では以下を実行してください（GITHUB_OP_PACKAGE_READ に read:packages スコープ付き Classic PAT を設定）:

  cat > ~/.nuget/NuGet/NuGet.Config << EOF
  <?xml version="1.0" encoding="utf-8"?>
  <configuration>
    <packageSources>
      <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
      <add key="github" value="https://nuget.pkg.github.com/kenyamaneko/index.json" />
    </packageSources>
    <packageSourceCredentials>
      <github>
        <add key="Username" value="kenyamaneko" />
        <add key="ClearTextPassword" value="${GITHUB_OP_PACKAGE_READ}" />
      </github>
    </packageSourceCredentials>
  </configuration>
  EOF
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/kenyamaneko/index.json" />
  </packageSources>
</configuration>
